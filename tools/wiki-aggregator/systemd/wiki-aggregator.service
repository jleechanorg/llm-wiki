[Unit]
Description=LLM Wiki aggregator — sync per-project wikis into ~/llm_wiki
Documentation=https://github.com/jleechanorg/llm-wiki/tree/main/tools/wiki-aggregator

[Service]
Type=oneshot
WorkingDirectory=%h
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/wiki-aggregator
StandardOutput=journal
StandardError=journal
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jleechan.wiki-daily-worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.local/bin/wiki-daily-worker</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LLM_WIKI_DIR</key>
        <string>@HOME@/llm_wiki</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/wiki-daily-worker.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/wiki-daily-worker.error.log</string>
    <key>RunAtLoad</key>
    <false/>
    <key>WorkingDirectory</key>
    <string>@HOME@</string>
</dict>
</plist>
